#!/usr/bin/env bash
# ⚡ xLFr4n // Kali BSPWM 2026
# Follow the active default route instead of assuming wired networking.
set -u

iface="$(ip route show default 2>/dev/null | awk 'NR==1 {print $5}')"
[ -n "$iface" ] || { printf ' offline\n'; exit 0; }

case "$iface" in
  wl*) icon='' ;;
  en*|eth*) icon='' ;;
  tun*|wg*) icon='' ;;
  *) icon='' ;;
esac

state="$(cat "/sys/class/net/$iface/operstate" 2>/dev/null || printf "unknown")"
[ "$state" = "up" ] || { printf "%s offline\n" "$icon"; exit 0; }

ip4="$(ip -4 addr show dev "$iface" 2>/dev/null | awk '/inet / {sub(/\/.*/, "", $2); print $2; exit}')"
printf "%s %s\n" "$icon" "${ip4:-connected}"