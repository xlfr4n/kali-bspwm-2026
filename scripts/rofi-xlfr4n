#!/usr/bin/env bash
# ⚡ xlfr4n // Kali BSPWM 2026
# Rofi entrypoint with theme validation and a clean default fallback.

set -Eeuo pipefail

THEME="$HOME/.config/rofi/launcher.rasi"
FALLBACK="$HOME/.config/rofi/fallback.rasi"
LOG="$HOME/.cache/xlfr4n-rofi.log"

mkdir -p "$(dirname "$LOG")"

if command -v rofi >/dev/null 2>&1 && [ -f "$THEME" ]; then
  if rofi -no-config -theme "$THEME" -dump-theme >/dev/null 2>&1; then
    exec rofi -no-config -theme "$THEME" "$@"
  fi

  printf '[%s] Invalid Rofi theme; using dark fallback.\n' "$(date '+%Y-%m-%d %H:%M:%S')" >> "$LOG"
fi

if [ -f "$FALLBACK" ] && rofi -no-config -theme "$FALLBACK" -dump-theme >/dev/null 2>&1; then
  exec rofi -no-config -theme "$FALLBACK" "$@"
fi

exec rofi -no-config "$@"
