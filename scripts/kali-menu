#!/usr/bin/env bash
# ⚡ xlfr4n // Kali BSPWM 2026

set -Eeuo pipefail

command -v rofi-xlfr4n >/dev/null 2>&1 || {
  echo "rofi-xlfr4n is not installed." >&2
  exit 1
}

choice="$(
  printf '%s\n' \
    'TERMINAL  Ghostty + tmux' \
    'SPOTLIGHT Launch apps' \
    'MISSION   Window overview' \
    'BRAVE     Open Brave' \
    'FIREFOX   Open Firefox' \
    'WIRESHARK Capture & analyse traffic' \
    'BURP      Open Burp Suite' \
    'DOCK      Toggle floating dock' \
    'REPAIR    Re-sync dock backends' \
    'DESKTOP   Apply desktop style' \
    'TARGET    Set / clear target' \
    'THEME     Change theme' \
    'WALLPAPER Change wallpaper' \
    'LAB       Open Kali Lab' \
    'MONITOR   Refresh displays' \
    'NETWORK   Network manager' \
    'DOCTOR    Run diagnostics' \
    'SYSTEM    Terminal system snapshot' \
    'VIRT      Virtualization tools' \
    'SCREEN    Screenshot menu' \
    'LOCK      Lock session' \
    'POWER     Power menu' \
    'EXIT      Close menu' |
    rofi-xlfr4n -dmenu -i -matching fuzzy -p '⚡ xLFr4n // Kali' || true
)"

case "$choice" in
  TERMINAL*) dock-launch terminal ;;
  SPOTLIGHT*) rofi-xlfr4n -show drun -show-icons -p 'Spotlight' ;;
  MISSION*) mission-control ;;
  BRAVE*) dock-launch brave ;;
  FIREFOX*) dock-launch firefox ;;
  WIRESHARK*) dock-launch wireshark ;;
  BURP*) dock-launch burp ;;
  DOCK*) dock --toggle ;;
  REPAIR*) dock --restart ;;
  DESKTOP*) desktop-style --apply ;;
  TARGET*) settarget ;;
  THEME*) theme-switch ;;
  WALLPAPER*) wallpaper --random ;;
  LAB*) dock-launch lab ;;
  MONITOR*) monitor-refresh ;;
  NETWORK*) dock-launch network ;;
  DOCTOR*) xlfr4n-terminal --title Kali-Doctor -- doctor.sh ;;
  SYSTEM*) xlfr4n-terminal --title xLFr4n-System -- xlfr4n-banner --static ;;
  VIRT*) xlfr4n-terminal --title Virtualization-Tools -- vmware-tools ;;
  SCREEN*) screenshot-menu ;;
  LOCK*) lock-screen ;;
  POWER*) power-menu ;;
  EXIT*|"") exit 0 ;;
esac
