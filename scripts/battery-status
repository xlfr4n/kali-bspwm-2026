#!/usr/bin/env bash
# ⚡ xLFr4n // Kali BSPWM 2026
# Optional laptop battery indicator; silent on desktops and VMs.
set -u

battery=''
for candidate in /sys/class/power_supply/BAT*; do
  [ -d "$candidate" ] || continue
  battery="$candidate"
  break
done

[ -n "$battery" ] || exit 0
capacity="$(cat "$battery/capacity" 2>/dev/null || true)"
status="$(cat "$battery/status" 2>/dev/null || true)"
[[ "$capacity" =~ ^[0-9]+$ ]] || exit 0

if [ "$status" = "Charging" ]; then
  icon=''
elif [ "$status" = "Full" ]; then
  icon=''
elif [ "$capacity" -le 15 ]; then
  icon=''
elif [ "$capacity" -le 35 ]; then
  icon=''
elif [ "$capacity" -le 65 ]; then
  icon=''
elif [ "$capacity" -le 85 ]; then
  icon=''
else
  icon=''
fi

printf "%s %s%%\n" "$icon" "$capacity"