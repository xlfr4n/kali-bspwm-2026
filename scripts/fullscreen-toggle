#!/usr/bin/env bash
# ⚡ xLFr4n // Kali BSPWM 2026
# Reliable fullscreen toggle: scope fullscreen to the focused window.
# Desktop chrome is never killed globally, so Polybar/Dock remain available
# when switching to another workspace while a fullscreen window is active.
set -Eeuo pipefail

is_fullscreen() {
  command -v jq >/dev/null 2>&1 || return 1
  [ "$(bspc query -T -n focused 2>/dev/null | jq -r '.client.state // empty')" = "fullscreen" ]
}

toggle() {
  bspc query -N -n focused >/dev/null 2>&1 || exit 0

  # BSPWM scopes fullscreen to the focused node. Do not stop Polybar or Dock:
  # they are session-wide services and must remain available on other desktops.
  bspc node -t "~fullscreen"
}

toggle
