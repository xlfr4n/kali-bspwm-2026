#!/usr/bin/env bash
# ⚡ xLFr4n // Kali BSPWM 2026
# Unified application launch feedback for keyboard and desktop actions.
set -Eeuo pipefail

export PATH="$HOME/.local/bin:$PATH"

label="${1:-Application}"
shift || true

if [ "${1:-}" = "--class" ]; then
  wmclass="${2:-}"
  shift 2
else
  wmclass=""
fi

[ "${1:-}" = "--" ] && shift

[ "$#" -gt 0 ] || {
  echo "Usage: xlfr4n-launch LABEL [--class WMCLASS] -- COMMAND [ARGS...]" >&2
  exit 2
}

NOTIFY_TAG="xLFr4n-keyboard-${label//[^[:alnum:]_-]/-}"

ensure_dunst() {
  command -v dunst >/dev/null 2>&1 || return 0
  if ! pgrep -u "$UID" -x dunst >/dev/null 2>&1; then
    dunst >/dev/null 2>&1 &
    sleep 0.08
  fi
}

notify() {
  command -v notify-send >/dev/null 2>&1 || return 0
  ensure_dunst
  notify-send     -u normal     -t "${3:-1400}"     -h "string:x-dunst-stack-tag:$NOTIFY_TAG"     "$1" "$2" >/dev/null 2>&1 || true
}

notify "⚡ xLFr4n // OPENING" "$label  ·  starting..." 1400

"$@" >/dev/null 2>&1 &
pid=$!

sleep 0.30

if [ -n "$wmclass" ] && command -v wmctrl >/dev/null 2>&1; then
  deadline=$((SECONDS + 5))
  while (( SECONDS < deadline )); do
    if wmctrl -lx 2>/dev/null | awk -v want="${wmclass,,}" 'BEGIN { IGNORECASE=1 } { class=tolower($3); if (index(class, want) > 0) { found=1; exit } } END { exit(found ? 0 : 1) }'; then
      notify "⚡ xLFr4n // READY" "$label  ·  window ready." 1400
      exit 0
    fi
    if ! kill -0 "$pid" 2>/dev/null; then
      break
    fi
    sleep 0.20
  done
fi

if kill -0 "$pid" 2>/dev/null; then
  notify "⚡ xLFr4n // OPEN" "$label  ·  launch requested." 1400
else
  notify "⚡ xLFr4n // FAILED" "$label  ·  launch process exited immediately." 3000
  exit 1
fi
