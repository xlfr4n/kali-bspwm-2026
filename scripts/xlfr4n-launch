#!/usr/bin/env bash
# ⚡ xLFr4n // Kali BSPWM 2026
# Unified application launch feedback for keyboard and desktop actions.
set -Eeuo pipefail

label="${1:-Application}"
shift || true

if [ "${1:-}" = "--class" ]; then
  wmclass="${2:-}"
  shift 2
else
  wmclass=""
fi

[ "${1:-}" = "--" ] && shift

[ "$#" -gt 0 ] || {
  echo "Usage: xlfr4n-launch LABEL [--class WMCLASS] -- COMMAND [ARGS...]" >&2
  exit 2
}

notify() {
  command -v notify-send >/dev/null 2>&1 || return 0
  notify-send -u low -t "${3:-1200}" "$1" "$2" >/dev/null 2>&1 || true
}

notify "xLFr4n // LAUNCH" "$label  ·  starting..."

"$@" >/dev/null 2>&1 &
pid=$!

sleep 0.30

if ! kill -0 "$pid" 2>/dev/null; then
  notify "xLFr4n // READY" "$label  ·  process started." 1200
  exit 0
fi

if [ -n "$wmclass" ] && command -v wmctrl >/dev/null 2>&1; then
  deadline=$((SECONDS + 5))
  while (( SECONDS < deadline )); do
    if wmctrl -lx 2>/dev/null | awk -v want="${wmclass,,}" 'BEGIN { IGNORECASE=1 } { class=tolower($3); if (index(class, want) > 0) { found=1; exit } } END { exit(found ? 0 : 1) }'; then
      notify "xLFr4n // READY" "$label  ·  window ready." 1200
      exit 0
    fi
    sleep 0.20
  done
fi

notify "xLFr4n // OPEN" "$label  ·  launch requested." 1200
