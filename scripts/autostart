#!/usr/bin/env bash
# ⚡ xlfr4n // Kali BSPWM 2026
# Fast session bootstrap: expose a usable BSPWM session first, then stage visual polish.
set -Eeuo pipefail

LOCK_FILE="$HOME/.cache/xlfr4n-autostart.lock"
mkdir -p "$HOME/.cache"
exec 9>"$LOCK_FILE"
if command -v flock >/dev/null 2>&1; then
  flock -n 9 || exit 0
fi

log(){
  mkdir -p "$HOME/.cache"
  printf '[%s] %s\n' "$(date '+%H:%M:%S.%3N')" "$*" >> "$HOME/.cache/xlfr4n-session.log"
}

# Clear only visual/session leftovers owned by the current user.
for proc in sxhkd polybar dunst picom plank tint2; do
  if pgrep -x "$proc" >/dev/null 2>&1; then
    pkill -u "$UID" -x "$proc" 2>/dev/null || true
  fi
done

mkdir -p "$HOME/.config/polybar" "$HOME/.config/theme-state" "$HOME/.config/wallpaper-state" "$HOME/.config/plank/dock1" "$HOME/.cache"
# One-shot TARGET entry animation window; the Polybar target stays static afterwards.
date '+%s%3N' > "$HOME/.cache/xlfr4n-target-boot-ms"

if [ -x "$HOME/.local/bin/workspace-hud" ]; then
  "$HOME/.local/bin/workspace-hud" --stop >/dev/null 2>&1 || true
fi

# ═══════════════════════════════════════════════════════════
# PHASE 1 — minimum viable session
# Keep this phase deliberately tiny so the display manager can
# hand over to BSPWM without waiting on cosmetic work.
# ═══════════════════════════════════════════════════════════
log "phase=core start"

if command -v sxhkd >/dev/null 2>&1; then
  sxhkd >/dev/null 2>&1 &
fi

if [ -x "$HOME/.local/bin/keyboard" ]; then
  "$HOME/.local/bin/keyboard" >/dev/null 2>&1 &
fi

# Replace the default X11 "cross" cursor with a normal arrow on the root window.
if command -v xsetroot >/dev/null 2>&1; then
  xsetroot -cursor_name left_ptr >/dev/null 2>&1 || true
fi

# Apply the runtime accent without rewriting any files.
if command -v bspc >/dev/null 2>&1; then
  theme="$(cat "$HOME/.config/theme-state/current" 2>/dev/null || printf "cyber-red")"
  case "$theme" in
    htb-green) accent="#9fef00" ;;
    nord) accent="#88c0d0" ;;
    purple) accent="#bd93f9" ;;
    *) accent="#ff3344" ;;
  esac
  bspc config active_border_color "$accent"
  bspc config focused_border_color "$accent"
  bspc config presel_feedback_color "$accent"
fi

log "phase=core ready"

# Keep Dunst ready before any user-visible launcher feedback.
if command -v dunst >/dev/null 2>&1 && ! pgrep -u "$UID" -x dunst >/dev/null 2>&1; then
  dunst >/dev/null 2>&1 &
  sleep 0.08
fi

# ═══════════════════════════════════════════════════════════
# PHASE 2 — staged visual polish
# Each task starts independently after a small delay. This avoids
# converting wallpapers, probing monitors and launching compositors
# at the exact same instant on a virtual machine.
# ═══════════════════════════════════════════════════════════
log "dunst ready"

(
  sleep 0.16
  if [ -x "$HOME/.local/bin/workspace-hud" ]; then
    "$HOME/.local/bin/workspace-hud" --daemon >/dev/null 2>&1 &
  fi
  log "workspace hud dispatched"
) &

(
  sleep 0.10
  if [ -x "$HOME/.config/polybar/launch.sh" ]; then
    "$HOME/.config/polybar/launch.sh" >/dev/null 2>&1 &
  fi
  log "polybar dispatched"
) &

(
  sleep 0.15
  "$HOME/.local/bin/monitor-refresh" --startup >/dev/null 2>&1 || true
  log "monitor refresh done"
) &

(
  sleep 0.25
  "$HOME/.local/bin/desktop-style" --apply --silent >/dev/null 2>&1 || true
  log "desktop style ready"
) &

(
  sleep 0.45
  nice -n 10 "$HOME/.local/bin/wallpaper" --default >/dev/null 2>&1 || true
  log "wallpaper ready"
) &

(
  sleep 0.65
  "$HOME/.local/bin/dock" --start >/dev/null 2>&1 || true
  log "dock ready"
) &

(
  sleep 0.95
  "$HOME/.local/bin/workspace-rail" --restart >/dev/null 2>&1 || true
  log "workspace rail ready"
) &

(
  sleep 1.10
  "$HOME/.local/bin/start-picom" >/dev/null 2>&1 || true
  log "picom ready"
) &

log "phase=background staged"

# Polkit agent: without one, GUI tools that need privileges (Wireshark helpers, gparted,
# NetworkManager edits) fail silently. Start the first agent found; absence is harmless.
(
  sleep 0.80
  if ! pgrep -u "$UID" -f 'polkit.*agent|lxpolkit' >/dev/null 2>&1; then
    for agent in \
      /usr/libexec/polkit-gnome-authentication-agent-1 \
      /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1 \
      /usr/lib/x86_64-linux-gnu/libexec/polkit-kde-authentication-agent-1 \
      "$(command -v lxpolkit 2>/dev/null || true)"; do
      if [ -n "$agent" ] && [ -x "$agent" ]; then
        "$agent" >/dev/null 2>&1 &
        break
      fi
    done
  fi
  log "polkit agent checked"
) &

# Optional idle lock. Off by default; enable with:  echo 10 > ~/.config/xlfr4n/autolock  (minutes)
(
  sleep 1.30
  lock_file="$HOME/.config/xlfr4n/autolock"
  if [ -r "$lock_file" ] && command -v xss-lock >/dev/null 2>&1 && [ -x "$HOME/.local/bin/lock-screen" ]; then
    minutes="$(tr -dc '0-9' < "$lock_file" | head -c 3 || true)"
    if [ -n "$minutes" ] && [ "$minutes" -gt 0 ]; then
      pkill -u "$UID" -x xss-lock 2>/dev/null || true
      xset s "$((minutes * 60))" 10 >/dev/null 2>&1 || true
      xss-lock --transfer-sleep-lock -- "$HOME/.local/bin/lock-screen" >/dev/null 2>&1 &
      log "autolock enabled (${minutes} min)"
    fi
  fi
) &
