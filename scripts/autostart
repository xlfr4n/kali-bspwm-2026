#!/usr/bin/env bash
# ⚡ xlfr4n // Kali BSPWM 2026
# Fast session bootstrap: expose a usable BSPWM session first, then stage visual polish.
set -Eeuo pipefail

LOCK_FILE="$HOME/.cache/xlfr4n-autostart.lock"
mkdir -p "$HOME/.cache"
exec 9>"$LOCK_FILE"
if command -v flock >/dev/null 2>&1; then
  flock -n 9 || exit 0
fi

log(){
  mkdir -p "$HOME/.cache"
  printf '[%s] %s\n' "$(date '+%H:%M:%S.%3N')" "$*" >> "$HOME/.cache/xlfr4n-session.log"
}

# Clear only visual/session leftovers owned by the current user.
for proc in sxhkd polybar dunst picom plank tint2; do
  if pgrep -x "$proc" >/dev/null 2>&1; then
    pkill -u "$UID" -x "$proc" 2>/dev/null || true
  fi
done

mkdir -p "$HOME/.config/polybar" "$HOME/.config/theme-state" "$HOME/.config/wallpaper-state" "$HOME/.config/plank/dock1" "$HOME/.cache"

if [ -x "$HOME/.local/bin/workspace-hud" ]; then
  "$HOME/.local/bin/workspace-hud" --stop >/dev/null 2>&1 || true
fi

# ═══════════════════════════════════════════════════════════
# PHASE 1 — minimum viable session
# Keep this phase deliberately tiny so the display manager can
# hand over to BSPWM without waiting on cosmetic work.
# ═══════════════════════════════════════════════════════════
log "phase=core start"

if command -v sxhkd >/dev/null 2>&1; then
  sxhkd >/dev/null 2>&1 &
fi

if [ -x "$HOME/.local/bin/keyboard" ]; then
  "$HOME/.local/bin/keyboard" >/dev/null 2>&1 &
fi

# Apply the runtime accent without rewriting any files.
if command -v bspc >/dev/null 2>&1; then
  theme="$(cat "$HOME/.config/theme-state/current" 2>/dev/null || printf "cyber-red")"
  case "$theme" in
    htb-green) accent="#9fef00" ;;
    nord) accent="#88c0d0" ;;
    purple) accent="#bd93f9" ;;
    *) accent="#ff3344" ;;
  esac
  bspc config active_border_color "$accent"
  bspc config focused_border_color "$accent"
  bspc config presel_feedback_color "$accent"
fi

log "phase=core ready"

# ═══════════════════════════════════════════════════════════
# PHASE 2 — staged visual polish
# Each task starts independently after a small delay. This avoids
# converting wallpapers, probing monitors and launching compositors
# at the exact same instant on a virtual machine.
# ═══════════════════════════════════════════════════════════
(
  sleep 0.05
  if command -v dunst >/dev/null 2>&1; then
    dunst >/dev/null 2>&1 &
  fi
  log "dunst dispatched"
) &

(
  sleep 0.16
  if [ -x "$HOME/.local/bin/workspace-hud" ]; then
    "$HOME/.local/bin/workspace-hud" --daemon >/dev/null 2>&1 &
  fi
  log "workspace hud dispatched"
) &

(
  sleep 0.10
  if [ -x "$HOME/.config/polybar/launch.sh" ]; then
    "$HOME/.config/polybar/launch.sh" >/dev/null 2>&1 &
  fi
  log "polybar dispatched"
) &

(
  sleep 0.15
  "$HOME/.local/bin/monitor-refresh" --startup >/dev/null 2>&1 || true
  log "monitor refresh done"
) &

(
  sleep 0.25
  "$HOME/.local/bin/desktop-style" --apply --silent >/dev/null 2>&1 || true
  log "desktop style ready"
) &

(
  sleep 0.45
  nice -n 10 "$HOME/.local/bin/wallpaper" --random >/dev/null 2>&1 || true
  log "wallpaper ready"
) &

(
  sleep 0.65
  "$HOME/.local/bin/dock" --start >/dev/null 2>&1 || true
  log "dock ready"
) &

(
  sleep 0.85
  "$HOME/.local/bin/start-picom" >/dev/null 2>&1 || true
  log "picom ready"
) &

log "phase=background staged"
