#!/usr/bin/env bash
# ⚡ xlfr4n // Kali BSPWM 2026
# Session bootstrap: runtime only; project identity lives across the whole desktop.

set -Eeuo pipefail

# Remove any tray applet left by an older session; network status now lives inside Polybar.
pkill -x nm-applet 2>/dev/null || true

for proc in sxhkd polybar dunst picom plank tint2; do
  pkill -x "$proc" 2>/dev/null || true
done

mkdir -p "$HOME/.config/polybar" "$HOME/.config/theme-state" "$HOME/.config/wallpaper-state" "$HOME/.config/plank/dock1"

command -v sxhkd >/dev/null 2>&1 && sxhkd >/dev/null 2>&1 &
"$HOME/.local/bin/keyboard" >/dev/null 2>&1 &

sleep 0.5
"$HOME/.local/bin/monitor-refresh" --startup >/dev/null 2>&1 &
"$HOME/.local/bin/wallpaper" --random >/dev/null 2>&1 &

"$HOME/.local/bin/desktop-style" --apply --silent >/dev/null 2>&1 &
"$HOME/.local/bin/dock" --start >/dev/null 2>&1 &

command -v dunst >/dev/null 2>&1 && dunst >/dev/null 2>&1 &
command -v nm-applet >/dev/null 2>&1 && nm-applet >/dev/null 2>&1 &
"$HOME/.local/bin/theme-switch" --apply-current --silent >/dev/null 2>&1 &

(sleep 1; "$HOME/.local/bin/start-picom" >/dev/null 2>&1) &
