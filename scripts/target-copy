#!/usr/bin/env bash
# ⚡ xLFr4n // Kali BSPWM 2026
# Copy the active target value to the X11 clipboard.
set -Eeuo pipefail

TARGET_FILE="$HOME/.config/polybar/target"

[ -s "$TARGET_FILE" ] || {
  command -v notify-send >/dev/null 2>&1 && notify-send -u low -t 1600 "xLFr4n • Target" "No target is currently set." || true
  exit 1
}

value="$(sed 's/[[:space:]]*·.*$//' "$TARGET_FILE" | head -n1)"
[ -n "$value" ] || exit 1

if command -v xclip >/dev/null 2>&1; then
  printf "%s" "$value" | xclip -selection clipboard
elif command -v xsel >/dev/null 2>&1; then
  printf "%s" "$value" | xsel --clipboard --input
else
  command -v notify-send >/dev/null 2>&1 && notify-send -u critical -t 2600 "xLFr4n • Clipboard unavailable" "Install xclip to copy targets from Polybar." || true
  exit 127
fi

command -v notify-send >/dev/null 2>&1 && notify-send -u low -t 1500 "xLFr4n • TARGET copied" "$value  ·  clipboard ready." || true
printf "%s\n" "$value"
