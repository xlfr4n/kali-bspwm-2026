#!/usr/bin/env bash
# ⚡ xLFr4n // Kali BSPWM 2026
# Copy the active target value to the X11 clipboard.
set -Eeuo pipefail

TARGET_FILE="$HOME/.config/polybar/target"

notify() {
  local urgency="$1"
  local timeout="$2"
  local title="$3"
  local body="$4"
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -u "$urgency" -t "$timeout" "$title" "$body" >/dev/null 2>&1 || true
  fi
}

[ -s "$TARGET_FILE" ] || {
  notify low 1600 "xLFr4n • Target" "No target is currently set."
  exit 1
}

value="$(sed 's/[[:space:]]*·.*$//' "$TARGET_FILE" | head -n1)"
[ -n "$value" ] || exit 1

if command -v xclip >/dev/null 2>&1; then
  printf "%s" "$value" | xclip -selection clipboard
elif command -v xsel >/dev/null 2>&1; then
  printf "%s" "$value" | xsel --clipboard --input
else
  notify critical 2600 "xLFr4n • Clipboard unavailable" "Install xclip to copy targets from Polybar."
  exit 127
fi

notify low 1500 "xLFr4n • TARGET copied" "$value  ·  clipboard ready."
printf "%s\n" "$value"
