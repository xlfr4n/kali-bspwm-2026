#!/usr/bin/env bash
# ⚡ xLFr4n // Kali BSPWM 2026
# Fixed-width terminal identity. The frame stays ASCII-only so font fallback
# cannot change its geometry; information columns are padded explicitly.
# v3: richer boot animation, localized date/time and a clean operator footer.
set -u

THEME_FILE="$HOME/.config/theme-state/current"
TARGET_FILE="$HOME/.config/polybar/target"

theme="$(cat "$THEME_FILE" 2>/dev/null || printf 'cyber-red')"
virt="$(systemd-detect-virt 2>/dev/null || printf 'host')"
session="${DESKTOP_SESSION:-bspwm}"
target="$(cat "$TARGET_FILE" 2>/dev/null || true)"
kernel="$(uname -sr 2>/dev/null || printf 'unknown')"
uptime="$(uptime -p 2>/dev/null | sed 's/^up //' || printf 'unknown')"
resolution="$(xrandr 2>/dev/null | awk '/ connected primary | connected / {for (i=1;i<=NF;i++) if ($i ~ /^[0-9]+x[0-9]+\+/) {sub(/\+.*/, "", $i); print $i; exit}}')"
resolution="${resolution:-unknown}"

case "$virt" in
  oracle|virtualbox) virt='VirtualBox' ;;
  vmware) virt='VMware' ;;
  qemu) virt='QEMU/KVM' ;;
  kvm) virt='KVM' ;;
  none|'') virt='Host' ;;
esac

case "$theme" in
  htb-green) accent=32; bright=92 ;;
  nord) accent=36; bright=96 ;;
  purple) accent=35; bright=95 ;;
  *) accent=31; bright=91 ;;
esac

if command -v free >/dev/null 2>&1; then
  memory="$(free -h | awk '/^Mem:/ {print $3 "/" $2}')"
else
  memory="unknown"
fi

cpu="$(nproc 2>/dev/null || printf '?') cores"
host="$(hostname 2>/dev/null || printf 'unknown')"
arch="$(uname -m 2>/dev/null || printf 'unknown')"
shell_name="${SHELL##*/}"
shell_name="${shell_name:-sh}"

# GNU date localizes %A/%B through LC_TIME. Keep normal system precedence.
language="${LC_ALL:-${LC_TIME:-${LANG:-C}}}"
case "$language" in
  es*) now="$(LC_TIME="$language" date '+%A, %-d de %B de %Y · %H:%M')" ;;
  *) now="$(LC_TIME="$language" date '+%A, %-d %B %Y · %H:%M')" ;;
esac

clip_field() {
  local value="${1:-}"
  local max="${2:-64}"
  LC_ALL=C printf '%s' "$value" | cut -c1-"$max"
}

frame_line() {
  local value
  value="$(clip_field "${1:-}" 64)"
  printf '\033[%sm|\033[0m %-64s \033[%sm|\033[0m\n' "$accent" "$value" "$accent"
}

frame_center() {
  local value="${1:-}"
  local length left right
  value="$(clip_field "$value" 64)"
  length=${#value}
  left=$(( (64 - length) / 2 ))
  right=$(( 64 - length - left ))
  printf '\033[%sm|\033[0m%*s%s%*s\033[%sm|\033[0m\n' \
    "$accent" "$left" '' "$value" "$right" '' "$accent"
}

frame_section() {
  frame_line "  ${1:-}"
}

pair_line() {
  local a="${1:-}" b="${2:-}" c="${3:-}" d="${4:-}" e="${5:-}" f="${6:-}"
  local content
  a="$(clip_field "$a" 8)"
  b="$(clip_field "$b" 12)"
  c="$(clip_field "$c" 6)"
  d="$(clip_field "$d" 12)"
  e="$(clip_field "$e" 6)"
  f="$(clip_field "$f" 13)"
  printf -v content '%-8s %-12s  %-6s %-12s  %-6s %-13s' "$a" "$b" "$c" "$d" "$e" "$f"
  frame_line "$content"
}

target_line() {
  local value="${1:-not set}"
  value="$(clip_field "$value" 51)"
  frame_line "$(printf '%-8s %-51s' 'TARGET' "$value")"
}

animate_boot() {
  [ "${1:-}" = "--static" ] && return 0
  [ -t 1 ] || return 0
  local phase index progress spinner bar fill
  local -a phases=("BOOT" "LINK" "SYNC" "DRAW" "READY")
  local -a progress_values=(8 26 52 76 100)
  local -a spinners=('|' '/' '-' '\')

  for index in "${!phases[@]}"; do
    phase="${phases[$index]}"
    progress="${progress_values[$index]}"
    spinner="${spinners[$((index % ${#spinners[@]}))]}"
    printf -v bar '%*s' 20 ''
    bar="${bar// /#}"
    printf -v fill '%*s' "$((progress * 20 / 100))" ''
    fill="${fill// /#}"
    bar="${fill}${bar:${#fill}}"
    printf '\r\033[2K\033[%sm[ xLFr4n ]\033[0m  %s  %-5s  [%s]  %3d%%' \
      "$bright" "$spinner" "$phase" "$bar" "$progress"
    sleep 0.07
  done
  printf '\r\033[2K'
}

printf '\n'
animate_boot "${1:-}"

top_bottom() {
  printf '\033[%sm+------------------------------------------------------------------+\033[0m\n' "$accent"
}

top_bottom
frame_center 'xLFr4n // KALI'
frame_center 'PERSONAL SECURITY WORKSPACE'
top_bottom
frame_section 'SYSTEM SNAPSHOT // LIVE'
pair_line 'SESSION' "$session" 'VIRT' "$virt" 'THEME' "$theme"
pair_line 'KERNEL' "$kernel" 'CPU' "$cpu" 'MEMORY' "$memory"
pair_line 'DISPLAY' "$resolution" 'HOST' "$host" 'ARCH' "$arch"
pair_line 'SHELL' "$shell_name" 'UPTIME' "$uptime" '' ''
target_line "${target:-not set}"
frame_line "$(printf '%-8s %-56s' 'LOCAL' "$now")"
top_bottom
frame_line '  KITTY  CTRL+SHIFT+T TAB  ·  CTRL+SHIFT+N WINDOW  ·  CTRL+SHIFT+F5 RELOAD'
frame_line '  READY  xLFr4n // focused, readable, VM-friendly'
top_bottom
printf '\n'
