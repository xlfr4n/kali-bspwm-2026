#!/usr/bin/env bash
# ⚡ xLFr4n // Kali BSPWM 2026
# Fixed-width terminal identity. The frame is ASCII-only so JetBrains Mono
# and fallback fonts cannot change its geometry.
set -u

THEME_FILE="$HOME/.config/theme-state/current"
TARGET_FILE="$HOME/.config/polybar/target"

theme="$(cat "$THEME_FILE" 2>/dev/null || printf 'cyber-red')"
virt="$(systemd-detect-virt 2>/dev/null || printf 'host')"
session="${DESKTOP_SESSION:-bspwm}"
target="$(cat "$TARGET_FILE" 2>/dev/null || true)"
kernel="$(uname -sr 2>/dev/null || printf 'unknown')"
uptime="$(uptime -p 2>/dev/null | sed 's/^up //' || printf 'unknown')"
resolution="$(xrandr 2>/dev/null | awk '/ connected primary | connected / {for (i=1;i<=NF;i++) if ($i ~ /^[0-9]+x[0-9]+\+/) {sub(/\+.*/, "", $i); print $i; exit}}')"
resolution="${resolution:-unknown}"

if command -v free >/dev/null 2>&1; then
  memory="$(free -h | awk '/^Mem:/ {print $3 "/" $2}')"
else
  memory="unknown"
fi

cpu="$(nproc 2>/dev/null || printf '?') cores"

clip_field() {
  local value="${1:-}"
  LC_ALL=C printf '%s' "$value" | cut -c1-64
}

top_bottom() {
  printf '\033[31m+------------------------------------------------------------------+\033[0m\n'
}

frame_line() {
  local value
  value="$(clip_field "${1:-}")"
  printf '\033[31m|\033[0m %-64s \033[31m|\033[0m\n' "$value"
}

frame_center() {
  local value="${1:-}"
  local length left right
  value="$(clip_field "$value")"
  length=${#value}
  left=$(( (64 - length) / 2 ))
  right=$(( 64 - length - left ))
  printf '\033[31m|\033[0m%*s%s%*s\033[31m|\033[0m\n' "$left" '' "$value" "$right" ''
}

animate_boot() {
  [ "${1:-}" = "--static" ] && return 0
  [ -t 1 ] || return 0

  local phase
  for phase in "BOOT" "LINK" "SYNC" "DRAW" "READY"; do
    printf '\r\033[2K\033[31m[xLFr4n]\033[0m  %-5s  KALI WORKSPACE' "$phase"
    sleep 0.07
  done
  printf '\r\033[2K'
}

printf '\n'
animate_boot "${1:-}"
top_bottom
frame_center 'xLFr4n'
frame_center 'KALI / PERSONAL SECURITY LAB'
top_bottom
frame_line "SESSION  $session    VIRT  $virt    THEME  $theme"
frame_line "KERNEL   $kernel    CPU   $cpu    MEMORY  $memory"
frame_line "SCREEN   $resolution    UPTIME  $uptime"
if [ -n "$target" ]; then
  frame_line "TARGET   $target"
else
  frame_line "TARGET   not set"
fi
top_bottom
printf '\n'
