#!/usr/bin/env bash
# ⚡ xLFr4n // Kali BSPWM 2026
# Focus an existing application window when possible; otherwise launch it.
# The user always gets immediate launch feedback through Dunst.
set -Eeuo pipefail

app=${1:-}
shift || true

ensure_dunst() {
  command -v dunst >/dev/null 2>&1 || return 0
  if ! pgrep -u "$UID" -x dunst >/dev/null 2>&1; then
    dunst >/dev/null 2>&1 &
    sleep 0.08
  fi
}

notify() {
  command -v notify-send >/dev/null 2>&1 || return 0
  ensure_dunst
  notify-send -u normal -t "${3:-1400}" -h "string:x-dunst-stack-tag:${NOTIFY_TAG:-xLFr4n-launch}" "$1" "$2" >/dev/null 2>&1 || true
}

wait_for_window() {
  local want="$1"
  local deadline=$((SECONDS + 8))
  command -v wmctrl >/dev/null 2>&1 || return 1
  while (( SECONDS < deadline )); do
    if wmctrl -lx 2>/dev/null | awk -v want="${want,,}" 'BEGIN { IGNORECASE=1 } { class=tolower($3); if (index(class, want) > 0) { found=1; exit } } END { exit(found ? 0 : 1) }'; then
      return 0
    fi
    sleep 0.25
  done
  return 1
}

app_label=""
NOTIFY_TAG="xLFr4n-dock-${app:-unknown}"
case "$app" in
  brave) wmclass="brave-browser"; cmd=(brave-browser --new-window); [ "$#" -gt 0 ] && cmd+=( "$@" ); app_label="Brave Browser" ;;
  terminal)
    wmclass="com.mitchellh.ghostty"
    cmd=(xlfr4n-terminal)
    app_label="xLFr4n Terminal"
    ;;
  files) wmclass="thunar"; cmd=(thunar); app_label="Thunar" ;;
  code) wmclass="code"; cmd=(code); app_label="Visual Studio Code" ;;
  burp) wmclass="burpsuite"; cmd=(burpsuite); app_label="Burp Suite" ;;
  editor|nvim)
    wmclass="com.mitchellh.ghostty"
    cmd=(xlfr4n-terminal --title Neovim -- nvim)
    app_label="Neovim"
    ;;
  kali) wmclass=""; cmd=(kali-menu); app_label="xLFr4n Menu" ;;
  target)
    wmclass="com.mitchellh.ghostty"
    cmd=(xlfr4n-terminal --title Kali-Target -- settarget)
    app_label="Target Console"
    ;;
  lab)
    wmclass="com.mitchellh.ghostty"
    cmd=(xlfr4n-terminal --title Kali-Lab -- lab)
    app_label="Kali Lab"
    ;;
  btop)
    wmclass="com.mitchellh.ghostty"
    cmd=(xlfr4n-terminal --title xLFr4n-Monitor -- btop)
    app_label="System Monitor"
    ;;
  settings) wmclass="lxappearance"; cmd=(lxappearance); app_label="Appearance" ;;
  network) wmclass="nm-connection-editor"; cmd=(nm-connection-editor); app_label="Network" ;;
  screenshot) wmclass=""; cmd=(flameshot gui); app_label="Screenshot" ;;
  *) echo "Usage: dock-launch {brave|terminal|files|code|burp|editor|nvim|kali|target|lab|btop|settings|network|screenshot}" >&2; exit 2 ;;
esac

if [ -n "$wmclass" ] && command -v wmctrl >/dev/null 2>&1; then
  window_id="$(wmctrl -lx 2>/dev/null | awk -v want="${wmclass,,}" 'BEGIN { IGNORECASE=1 } { class=tolower($3); if (index(class, want) > 0) { print $1; exit } }')"
  if [ -n "$window_id" ]; then
    wmctrl -ia "$window_id" >/dev/null 2>&1 || true
    notify "⚡ xLFr4n // FOCUSED" "$app_label · already running."
    exit 0
  fi
fi

notify "⚡ xLFr4n // OPENING" "$app_label  ·  starting..." 1400
"${cmd[@]}" >/dev/null 2>&1 &

if [ -n "$wmclass" ] && wait_for_window "$wmclass"; then
  notify "⚡ xLFr4n // READY" "$app_label  ·  window ready." 1400
elif [ -n "$wmclass" ]; then
  notify "⚡ xLFr4n // WAITING" "$app_label · still starting; Mission Control remains available." 2600
else
  sleep 0.2
  notify "⚡ xLFr4n // STARTED" "$app_label · launch requested." 1400
fi
