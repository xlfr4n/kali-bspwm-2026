#!/usr/bin/env bash
# ⚡ xLFr4n // Kali BSPWM 2026
# Central terminal launcher. Ghostty is the only graphical terminal.
set -Eeuo pipefail

export PATH="$HOME/.local/bin:$PATH"

# VirtualBox commonly exposes OpenGL 4.1 to Linux guests, while Ghostty
# requires OpenGL 4.3+. In that VM, use Mesa software rendering automatically.
# Override with XLFR4N_GHOSTTY_SOFTWARE_RENDERING=0 to disable or 1 to force.
case "${XLFR4N_GHOSTTY_SOFTWARE_RENDERING:-auto}" in
  1|true|yes|on)
    export LIBGL_ALWAYS_SOFTWARE=1
    ;;
  0|false|no|off)
    ;;
  auto)
    if command -v systemd-detect-virt >/dev/null 2>&1; then
      case "$(systemd-detect-virt --vm 2>/dev/null || true)" in
        virtualbox)
          export LIBGL_ALWAYS_SOFTWARE=1
          ;;
      esac
    fi
    ;;
  *)
    echo "Invalid XLFR4N_GHOSTTY_SOFTWARE_RENDERING value; use auto, 0, or 1." >&2
    exit 2
    ;;
esac

GHOSTTY_BIN="${XLFR4N_GHOSTTY_BIN:-}"
if [ -z "$GHOSTTY_BIN" ] && command -v ghostty >/dev/null 2>&1; then
  GHOSTTY_BIN="$(command -v ghostty)"
elif [ -z "$GHOSTTY_BIN" ] && [ -x "$HOME/.local/bin/ghostty" ]; then
  GHOSTTY_BIN="$HOME/.local/bin/ghostty"
fi

title=""
cmd=()

usage() {
  cat <<'EOF'
Usage:
  xlfr4n-terminal
  xlfr4n-terminal --backend
  xlfr4n-terminal --ghostty
  xlfr4n-terminal [--title TITLE] -- COMMAND [ARGS...]

Backend:
  Ghostty only.
  tmux is used automatically when available.
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --backend)
      [ -x "$GHOSTTY_BIN" ] || {
        echo "Ghostty is not installed." >&2
        exit 1
      }
      printf '%s\n' "$GHOSTTY_BIN"
      exit 0
      ;;
    --ghostty)
      ;;
    --title)
      [ "$#" -ge 2 ] || { echo "--title requires a value." >&2; exit 2; }
      title="$2"
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    --)
      shift
      cmd=("$@")
      break
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
  shift
done


tmux_session="${XLFR4N_TMUX_SESSION:-xLFr4n}"

if [ "${#cmd[@]}" -eq 0 ]; then
  if command -v tmux >/dev/null 2>&1; then
    if [ -n "$title" ]; then
      exec "$GHOSTTY_BIN" --title="$title" -e tmux new-session -A -s "$tmux_session" 'env XLFR4N_FASTFETCH=1 zsh'
    fi
    exec "$GHOSTTY_BIN" -e tmux new-session -A -s "$tmux_session" 'env XLFR4N_FASTFETCH=1 zsh'
  fi

  if [ -n "$title" ]; then
    exec "$GHOSTTY_BIN" --title="$title"
  fi
  exec "$GHOSTTY_BIN"
fi

if [ -n "$title" ]; then
  exec "$GHOSTTY_BIN" --title="$title" -e "${cmd[@]}"
fi
exec "$GHOSTTY_BIN" -e "${cmd[@]}"
