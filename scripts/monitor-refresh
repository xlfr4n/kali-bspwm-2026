#!/usr/bin/env bash
set -Eeuo pipefail

command -v xrandr >/dev/null 2>&1 || exit 0
xrandr >/dev/null 2>&1 || exit 0

mapfile -t outputs < <(xrandr --query | awk '/ connected/ {print $1}')
[ "${#outputs[@]}" -gt 0 ] || exit 0

primary="${outputs[0]}"
xrandr --output "$primary" --auto --primary >/dev/null 2>&1 || true

if [ "${#outputs[@]}" -gt 1 ]; then
  prev="$primary"
  for out in "${outputs[@]:1}"; do
    xrandr --output "$out" --auto --right-of "$prev" >/dev/null 2>&1 || true
    prev="$out"
  done
fi

if command -v bspc >/dev/null 2>&1 && [ "${#outputs[@]}" -ge 2 ]; then
  mapfile -t monitors < <(bspc query -M --names 2>/dev/null || true)
  if [ "${#monitors[@]}" -ge 2 ]; then
    for d in 6 7 8 9 0; do
      bspc desktop "$d" --to-monitor "${monitors[1]}" >/dev/null 2>&1 || true
    done
    for d in 1 2 3 4 5; do
      bspc desktop "$d" --to-monitor "${monitors[0]}" >/dev/null 2>&1 || true
    done
  fi
fi

if [ "${1:-}" != "--startup" ]; then
  "$HOME/.config/polybar/launch.sh" >/dev/null 2>&1 &
fi
