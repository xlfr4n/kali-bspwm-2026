#!/usr/bin/env bash
set -Eeuo pipefail
mkdir -p "$HOME/Pictures/Screenshots"
choice=$(printf 'Region\nFull screen\n' | rofi -dmenu -p 'Screenshot' -theme "$HOME/.config/rofi/launcher.rasi" || true)
case "$choice" in
  Region) flameshot gui;;
  Full\ screen) flameshot full -p "$HOME/Pictures/Screenshots";;
esac
