#!/usr/bin/env bash
# ⚡ xlfr4n // Kali BSPWM 2026
# Brightness shortcuts with instant visual feedback. Silent on VMs/desktops without a backlight.
set -Eeuo pipefail

action="${1:-}"
case "$action" in
  up|down) ;;
  *) printf 'Usage: brightness-control {up|down}\n' >&2; exit 2 ;;
esac

percent=""

if command -v brightnessctl >/dev/null 2>&1; then
  # A machine can have brightnessctl installed without exposing any real
  # backlight (common on VMs). Treat that case as a deliberate no-op.
  if ! brightnessctl -c backlight get >/dev/null 2>&1; then
    exit 0
  fi

  if [ "$action" = "up" ]; then
    brightnessctl -c backlight -q set +5%
  else
    brightnessctl -c backlight -q set 5%-
  fi

  cur="$(brightnessctl -c backlight get 2>/dev/null || true)"
  max="$(brightnessctl -c backlight max 2>/dev/null || true)"
  if [[ "$cur" =~ ^[0-9]+$ && "$max" =~ ^[0-9]+$ && "$max" -gt 0 ]]; then
    percent=$(( cur * 100 / max ))
  fi

elif command -v xbacklight >/dev/null 2>&1; then
  # xbacklight can exist even when the current display exposes no usable
  # backlight controller. Probe before changing anything.
  if ! xbacklight -get >/dev/null 2>&1; then
    exit 0
  fi

  if [ "$action" = "up" ]; then
    xbacklight -inc 5 >/dev/null 2>&1 || exit 0
  else
    xbacklight -dec 5 >/dev/null 2>&1 || exit 0
  fi

  percent="$(xbacklight -get 2>/dev/null | cut -d. -f1 || true)"

else
  exit 0
fi

if [ -n "$percent" ] && command -v notify-send >/dev/null 2>&1; then
  notify-send -u low -t 850 -h int:value:"$percent" "xLFr4n // BRIGHTNESS" "${percent}%" >/dev/null 2>&1 || true
fi
