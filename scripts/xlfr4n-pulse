#!/usr/bin/env bash
# ⚡ xLFr4n // Kali BSPWM 2026
# Lightweight Polybar heartbeat. Uses shell-only timing to avoid spawning date repeatedly.
set -u

frames=(
  '⚡ xLFr4n // KALI'
  '⚡ xLFr4n > KALI'
  '⚡ xLFr4n >> KALI'
  '⚡ xLFr4n >>> KALI'
  '⚡ xLFr4n >> KALI'
  '⚡ xLFr4n > KALI'
)

tick="$(awk '{printf "%d", $1 * 10}' /proc/uptime 2>/dev/null || printf '0')"
printf '%s\n' "${frames[$((tick % ${#frames[@]}))]}"
