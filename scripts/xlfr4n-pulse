#!/usr/bin/env bash
# ⚡ xLFr4n // Kali BSPWM 2026
# Lightweight Polybar heartbeat with a smooth signal sweep.
set -u

frames=(
  '⚡ xLFr4n // KALI  [●··]'
  '⚡ xLFr4n // KALI  [●●·]'
  '⚡ xLFr4n // KALI  [●●●]'
  '⚡ xLFr4n // KALI  [·●●]'
  '⚡ xLFr4n // KALI  [··●]'
  '⚡ xLFr4n // KALI  [···]'
  '⚡ xLFr4n // KALI  [··●]'
  '⚡ xLFr4n // KALI  [·●●]'
)

tick="$(awk '{printf "%d", $1 * 10}' /proc/uptime 2>/dev/null || printf '0')"
index=$((tick % ${#frames[@]}))
printf '%s\n' "${frames[$index]}"
