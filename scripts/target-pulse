#!/usr/bin/env bash
# ⚡ xLFr4n // Kali BSPWM 2026
# Animated target indicator for the top-left status rail.
set -u

TARGET_FILE="$HOME/.config/polybar/target"
theme="$(cat "$HOME/.config/theme-state/current" 2>/dev/null || printf 'cyber-red')"
case "$theme" in
  htb-green) accent='#9fef00' ;;
  nord) accent='#88c0d0' ;;
  purple) accent='#bd93f9' ;;
  *) accent='#ff3344' ;;
esac

target="$(cat "$TARGET_FILE" 2>/dev/null || true)"
tick="$(awk '{printf "%d", $1 * 6}' /proc/uptime 2>/dev/null || printf '0')"
signals=('·' '•' '●' '•')
signal="${signals[$((tick % ${#signals[@]}))]}"

if [ -n "$target" ]; then
  printf '%%{F%s} %s %s%%{F-}' "$accent" "$target" "$signal"
else
  printf '%%{F%s} TARGET — %s%%{F-}' "$accent" "$signal"
fi
