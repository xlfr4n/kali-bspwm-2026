#!/usr/bin/env bash
# ⚡ xLFr4n // Kali BSPWM 2026
# Start Picom with a VM-aware backend choice and a deterministic fallback.
set -u

LOG="$HOME/.cache/xlfr4n-picom.log"
mkdir -p "$(dirname "$LOG")"
virt="$(systemd-detect-virt 2>/dev/null || true)"
backend="${XLFR4N_PICOM_BACKEND:-}"

if [ -z "$backend" ]; then
  case "$virt" in
    oracle|virtualbox|vmware|qemu|kvm) backend=xrender ;;
    *) backend= ;;
  esac
fi

pkill -u "$UID" -x picom 2>/dev/null || true
sleep 0.08

if [ -n "$backend" ]; then
  picom --backend "$backend" --config "$HOME/.config/picom/picom.conf" >>"$LOG" 2>&1 &
else
  picom --config "$HOME/.config/picom/picom.conf" >>"$LOG" 2>&1 &
fi

sleep 0.25
if ! pgrep -u "$UID" -x picom >/dev/null 2>&1; then
  picom --backend xrender --config "$HOME/.config/picom/picom.conf" >>"$LOG" 2>&1 &
fi
