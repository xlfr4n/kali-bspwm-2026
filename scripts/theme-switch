#!/usr/bin/env bash
# ⚡ xlfr4n // Kali BSPWM 2026
# Static themes only: no external theme engine is required for the core desktop.

set -Eeuo pipefail

POLYBAR="$HOME/.config/polybar/config.ini"
KITTY="$HOME/.config/kitty/kitty.conf"
ROFI="$HOME/.config/rofi/launcher.rasi"
DUNST="$HOME/.config/dunst/dunstrc"
TINT2="$HOME/.config/tint2/tint2rc"
STATE="$HOME/.config/theme-state"
mkdir -p "$STATE"

list_themes() {
  printf '%s\n' cyber-red htb-green nord purple
}

current_theme() {
  cat "$STATE/current" 2>/dev/null || printf 'cyber-red'
}

apply() {
  local t="$1"
  local silent="${2:-0}"
  local accent good warn border

  case "$silent" in
    0|1) ;;
    --silent) silent=1 ;;
    *) silent=0 ;;
  esac

  case "$t" in
    cyber-red) accent='#ff3344'; good='#5ee881'; warn='#ffc857' ;;
    htb-green) accent='#9fef00'; good='#5ee881'; warn='#ffc857' ;;
    nord) accent='#88c0d0'; good='#a3be8c'; warn='#ebcb8b' ;;
    purple) accent='#bd93f9'; good='#50fa7b'; warn='#f1fa8c' ;;
    *)
      echo "Unknown theme: $t" >&2
      return 2
      ;;
  esac
  border="#55${accent:1}"

  sed -i -E \
    "s/^accent = .*/accent = $accent/; s/^good = .*/good = $good/; s/^warn = .*/warn = $warn/; s/^border = .*/border = $border/" \
    "$POLYBAR"

  sed -i -E \
    "s/^selection_background .*/selection_background $accent/; s/^cursor .*/cursor $accent/" \
    "$KITTY"

  sed -i -E \
    "s/^  accent: .*/  accent: $accent;/" \
    "$ROFI"

  sed -i -E "s/^frame_color = .*/frame_color = \"$accent\"/" "$DUNST"
  if [ -f "$TINT2" ]; then
    sed -i -E "s/^border_color = .*/border_color = $accent 60/" "$TINT2"
  fi

  if command -v bspc >/dev/null 2>&1; then
    bspc config active_border_color "$accent"
    bspc config focused_border_color "$accent"
    bspc config presel_feedback_color "$accent"
  fi

  printf '%s\n' "$t" > "$STATE/current"

  if [ -x "$HOME/.config/polybar/launch.sh" ]; then
    "$HOME/.config/polybar/launch.sh" >/dev/null 2>&1 &
  fi
  if command -v dock >/dev/null 2>&1 &&
     (pgrep -x tint2 >/dev/null 2>&1 || pgrep -x plank >/dev/null 2>&1 || pgrep -af '[p]olybar dock' >/dev/null 2>&1); then
    dock --restart >/dev/null 2>&1 &
  fi

  if command -v dunstctl >/dev/null 2>&1; then
    dunstctl reload >/dev/null 2>&1 || true
  fi

  if [ "$silent" -eq 0 ] && command -v notify-send >/dev/null 2>&1; then
    notify-send "Kali BSPWM" "Theme: $t" || true
  fi
}

case "${1:-}" in
  --apply-default)
    apply cyber-red
    ;;
  --apply-current)
    apply "$(current_theme)" "${2:-0}"
    ;;
  --current)
    printf '%s\n' "$(current_theme)"
    ;;
  --list)
    list_themes
    ;;
  --random)
    apply "$(list_themes | shuf -n1)"
    ;;
  "")
    choice="$(list_themes | rofi-xlfr4n -dmenu -p 'Theme' || true)"
    [ -z "$choice" ] || apply "$choice"
    ;;
  *)
    apply "$1"
    ;;
esac
