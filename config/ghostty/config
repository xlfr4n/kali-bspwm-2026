# ⚡ xLFr4n // Ghostty terminal profile
# Primary and only graphical terminal for Kali BSPWM 2026.
# tmux provides persistence, panes and the lab workspace layer.

font-family = JetBrains Mono
font-size = 11
background = #101216
foreground = #f0f3f7
cursor-color = #ff3344
selection-background = #ff3344
selection-foreground = #101216
background-opacity = 1.0
window-padding-x = 10
window-padding-y = 8
window-decoration = none
window-save-state = never
confirm-close-surface = false

cursor-style = block
cursor-style-blink = true
scrollback-limit = 134217728
mouse-scroll-multiplier = 4
copy-on-select = false
right-click-action = copy
mouse-shift-capture = never
shell-integration = zsh
shell-integration-features = ssh-env,ssh-terminfo,no-cursor

window-height = 34
window-width = 118
gtk-tabs-location = top
gtk-wide-tabs = false
window-show-tab-bar = auto
window-inherit-working-directory = true

keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+q=close_surface
keybind = ctrl+shift+right=next_tab
keybind = ctrl+shift+left=previous_tab
keybind = ctrl+shift+comma=reload_config

# ⚡ xLFr4n // copy + scrollback controls
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+a=select_all
keybind = ctrl+shift+home=scroll_to_top
keybind = ctrl+shift+end=scroll_to_bottom
keybind = ctrl+shift+page_up=scroll_page_up
keybind = ctrl+shift+page_down=scroll_page_down
