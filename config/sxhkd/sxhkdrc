# ⚡ xlfr4n // Kali BSPWM 2026

super + Return
    xlfr4n-launch "Kitty" --class kitty -- kitty

super + d
    rofi-xlfr4n -show drun -show-icons

super + space
    rofi-xlfr4n -show drun -show-icons -p 'Spotlight'

super + shift + d
    rofi-xlfr4n -show run

super + shift + space
    mission-control

super + shift + h
    kali-menu

super + shift + a
    dock --toggle

super + shift + o
    mission-control

super + {q,w}
    bspc node -{c,k}

super + f
    fullscreen-toggle

super + s
    bspc node -t floating

super + t
    bspc node -t tiled

super + shift + t
    bspc node -t pseudo_tiled

super + m
    bspc desktop -l next

super + g
    bspc node -s biggest.window

super + {Left,Down,Up,Right}
    bspc node -f {west,south,north,east}

super + shift + {Left,Down,Up,Right}
    bspc node -s {west,south,north,east}

super + alt + {Left,Down,Up,Right}
    bspc node -z {left -30 0,bottom 0 30,top 0 -30,right 30 0}

super + ctrl + {Left,Down,Up,Right}
    bspc node -v {-30 0,0 30,0 -30,30 0}

super + {1,2,3,4,5,6,7,8,9}
    bspc desktop -f {1,2,3,4,5,6,7,8,9}

super + shift + {1,2,3,4,5,6,7,8,9}
    bspc node -d {1,2,3,4,5,6,7,8,9}

super + Tab
    bspc desktop -f last

super + alt + r
    bspc wm -r

super + alt + q
    bspc quit

super + alt + t
    theme-switch

super + ctrl + t
    theme-switch

super + shift + w
    wallpaper --random

super + ctrl + w
    wallpaper --next

super + shift + l
    xlfr4n-launch "Kali Lab" --class kali-lab -- kitty --class kali-lab --title Kali-Lab -e lab

super + shift + e
    xlfr4n-launch "Files" --class Thunar -- thunar

super + shift + p
    power-menu

super + shift + s
    screenshot-menu

super + shift + m
    monitor-refresh

super + ctrl + r
    xlfr4n-launch "Doctor" --class xLFr4n-Doctor -- kitty --class xLFr4n-Doctor --title Kali-Doctor -e doctor.sh

super + shift + i
    xlfr4n-launch "System Snapshot" --class xLFr4n-System -- kitty --class xLFr4n-System --title xLFr4n-System -e xlfr4n-banner --static

super + ctrl + x
    settarget

super + ctrl + v
    xlfr4n-launch "Virtualization Tools" --class VMware-Tools -- kitty --class VMware-Tools --title VMware-Tools -e vmware-tools

super + shift + f
    xlfr4n-launch "Firefox" --class firefox -- firefox

super + ctrl + b
    xlfr4n-launch "Brave Browser" --class brave-browser -- brave-browser --new-window

super + shift + b
    xlfr4n-launch "Burp Suite" --class BurpSuite -- burpsuite

super + shift + c
    xlfr4n-launch "Visual Studio Code" --class Code -- code

super + shift + n
    xlfr4n-launch "Neovim" --class floating_nvim -- kitty --class floating_nvim -e nvim

super + shift + k
    lock-screen

XF86AudioRaiseVolume
    audio-control up

XF86AudioLowerVolume
    audio-control down

XF86AudioMute
    audio-control mute

Print
    xlfr4n-launch "Screenshot" -- flameshot full -p "$HOME/Pictures/Screenshots"

shift + Print
    xlfr4n-launch "Screenshot" -- flameshot gui
