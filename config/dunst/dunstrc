# ⚡ xlfr4n // Kali BSPWM 2026
[global]
font = JetBrains Mono 10
frame_width = 2
corner_radius = 8
padding = 10
horizontal_padding = 10
separator_height = 1
separator_color = "frame"
width = 360
height = 0
origin = top-right
offset = 18x46
gap_size = 8
transparency = 4
word_wrap = true
stack_duplicates = true
hide_duplicate_count = true
history_length = 30
notification_limit = 8
show_indicators = true
frame_color = "#ff3344"
background = "#101216"
foreground = "#f0f3f7"

[urgency_low]
timeout = 3

[urgency_normal]
timeout = 5

[urgency_critical]
timeout = 0
frame_color = "#ffc857"
