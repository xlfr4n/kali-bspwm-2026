#!/usr/bin/env bash
# ⚡ xlfr4n // Kali BSPWM 2026
# Window-manager configuration. Session services are delegated to autostart.

set -u

export PATH="$HOME/.local/bin:$PATH"

bspc monitor -d 1 2 3 4 5 6 7 8 9

bspc config border_width 0
bspc config window_gap 10
bspc config top_padding 38
bspc config bottom_padding 0
bspc config split_ratio 0.50
bspc config borderless_monocle true
bspc config gapless_monocle true
bspc config honor_size_hints false
bspc config pointer_follows_focus false
bspc config focus_follows_pointer false
bspc config pointer_follows_monitor true
bspc config remove_disabled_monitors true
bspc config merge_overlapping_monitors true
bspc config normal_border_color '#262a31'
bspc config active_border_color '#262a31'
bspc config focused_border_color '#262a31'
bspc config presel_feedback_color '#ff3344'
bspc config automatic_scheme 'alternate'

bspc rule -a Pavucontrol state=floating center=true
bspc rule -a Arandr state=floating center=true
bspc rule -a Gpick state=floating center=true
bspc rule -a Nm-connection-editor state=floating center=true
bspc rule -a Lxappearance state=floating center=true
bspc rule -a floating_nvim state=floating center=true follow=true

# Paint an immediate dark root background so the X11 hand-off never looks blank.
if command -v xsetroot >/dev/null 2>&1; then
  xsetroot -solid '#101216'
fi

# Detach session helpers from BSPWM startup; visual polish must never hold the login path.
if [ -x "$HOME/.local/bin/autostart" ]; then
  if command -v setsid >/dev/null 2>&1; then
    setsid "$HOME/.local/bin/autostart" >/dev/null 2>&1 </dev/null &
  else
    "$HOME/.local/bin/autostart" >/dev/null 2>&1 </dev/null &
  fi
fi
