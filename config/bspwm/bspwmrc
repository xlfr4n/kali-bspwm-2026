#!/usr/bin/env bash

for proc in sxhkd polybar dunst nm-applet picom; do
  pkill -x "$proc" 2>/dev/null || true
done

sxhkd &
setxkbmap -layout es -variant '' >/dev/null 2>&1 || true
bspc monitor -d 1 2 3 4 5 6 7 8 9 0

bspc config border_width 2
bspc config window_gap 8
bspc config top_padding 2
bspc config split_ratio 0.55
bspc config borderless_monocle true
bspc config gapless_monocle true
bspc config focus_follows_pointer true
bspc config pointer_follows_monitor true
bspc config normal_border_color '#262a31'
bspc config active_border_color '#ff3344'
bspc config focused_border_color '#ff3344'
bspc config presel_feedback_color '#ff3344'
bspc config automatic_scheme 'alternate'

bspc rule -a Pavucontrol state=floating center=true
bspc rule -a Arandr state=floating center=true
bspc rule -a Gpick state=floating center=true
bspc rule -a Nm-connection-editor state=floating center=true
bspc rule -a floating_nvim state=floating center=true follow=true

"$HOME/.local/bin/monitor-refresh" --startup >/dev/null 2>&1 &
"$HOME/.local/bin/wallpaper" --random >/dev/null 2>&1 &
"$HOME/.config/polybar/launch.sh" >/dev/null 2>&1 &
command -v dunst >/dev/null 2>&1 && dunst >/dev/null 2>&1 &
command -v nm-applet >/dev/null 2>&1 && nm-applet >/dev/null 2>&1 &
"$HOME/.local/bin/theme-switch" --apply-current >/dev/null 2>&1 &
"$HOME/.local/bin/keyboard" >/dev/null 2>&1 &
(sleep 1; "$HOME/.local/bin/start-picom" >/dev/null 2>&1) &
