[Desktop Entry]
Type=Application
Version=1.0
Name=⚡ xLFr4n — Brave
Comment=Brave Browser for the xLFr4n workspace
Exec=/bin/sh -c "~/.local/bin/dock-launch brave $@" -- %U
Icon=brave-browser
Terminal=false
NoDisplay=true
StartupWMClass=brave-browser
MimeType=x-scheme-handler/http;x-scheme-handler/https;text/html;text/xml;
Categories=Network;WebBrowser;
StartupNotify=true
