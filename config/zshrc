# ⚡ xlfr4n // Kali BSPWM 2026
# Interactive shell layer for the xlfr4n desktop.
# Pasting commented command blocks works normally in interactive Zsh.

setopt interactivecomments
# Keep terminal bracketed-paste escape sequences out of the editable command line.
setopt BRACKETED_PASTE

export PATH="$HOME/.local/bin:$PATH"
export EDITOR=nvim
export VISUAL=nvim
export HISTSIZE=10000
export SAVEHIST=10000
export HISTFILE="$HOME/.zsh_history"

setopt HIST_IGNORE_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS
setopt INC_APPEND_HISTORY SHARE_HISTORY EXTENDED_HISTORY

# Completion system (was missing: Tab had no smart completion for git, ssh, kill, ...).
autoload -Uz compinit
compinit -C -d "${XDG_CACHE_HOME:-$HOME/.cache}/zcompdump"
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'

# Prefix history search on the arrow keys.
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search

[[ -r /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]] && source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh

# fzf: Ctrl+R fuzzy history, Ctrl+T files, Alt+C directories (installed but never wired before).
for _fzf in /usr/share/doc/fzf/examples/key-bindings.zsh /usr/share/fzf/key-bindings.zsh; do
  [[ -r "$_fzf" ]] && { source "$_fzf"; break; }
done
unset _fzf

# Debian/Kali ship fd as "fdfind" (bat is handled below).
if ! command -v fd >/dev/null 2>&1 && command -v fdfind >/dev/null 2>&1; then
  alias fd='fdfind'
fi

autoload -Uz add-zsh-hook

if command -v eza >/dev/null 2>&1; then
  alias ll='eza -lah --group-directories-first'
  alias la='eza -la --group-directories-first'
else
  alias ll='ls -lah'
  alias la='ls -la'
fi

alias cls='clear'
alias ports='ss -tulpn'
alias myip='ip -br addr'
alias serve='python3 -m http.server'
alias llh='history 20'
alias kmenu='kali-menu'
alias vmt='vmware-tools'
alias kdoctor='doctor.sh'
alias kbspwm='session-reload'

cat() {
  # Decorate only for interactive, flag-less use. Pipes, redirects and options
  # (cat -A, cat -n, ...) keep the real coreutils behaviour, so nothing breaks.
  if [[ -t 1 && $# -gt 0 && "$1" != -* ]]; then
    if command -v batcat >/dev/null 2>&1; then
      batcat --paging=never "$@"; return
    elif command -v bat >/dev/null 2>&1; then
      bat --paging=never "$@"; return
    fi
  fi
  command cat "$@"
}

settarget(){ "$HOME/.local/bin/settarget" "$@"; }
cleartarget(){ "$HOME/.local/bin/cleartarget"; }

mkhtb(){
  [[ -n "${1:-}" ]] || { echo "Usage: mkhtb NAME"; return 2; }
  mkdir -p "$1"/{nmap,loot,notes,web,exploits}
  echo "Workspace: $1"
}

mkcase(){
  [[ -n "${1:-}" ]] || { echo "Usage: mkcase NAME"; return 2; }
  mkdir -p "$1"/{recon,loot,notes,evidence,report}
  echo "Case: $1"
}

mkws(){
  [[ -n "${1:-}" ]] || { echo "Usage: mkws NAME"; return 2; }
  mkdir -p "$1"
  cd "$1"
}

alias st='settarget'
alias ct='cleartarget'
alias ctarget='cleartarget'
alias llab='lab'
alias xlbrief='xlfr4n-banner --static'
alias cliptarget='target-copy'
alias xlreload='session-reload'
alias sysinfo='xlfr4n-banner --static'

_kali_prompt() {
  local accent='red'
  local theme=''
  local target=''
  local git_branch=''

  [ -r "$HOME/.config/theme-state/current" ] &&
    theme="$(cat "$HOME/.config/theme-state/current" 2>/dev/null || true)"

  case "$theme" in
    htb-green) accent='green' ;;
    nord) accent='cyan' ;;
    purple) accent='magenta' ;;
    *) accent='red' ;;
  esac

  [ -r "$HOME/.config/polybar/target" ] &&
    target="$(cat "$HOME/.config/polybar/target" 2>/dev/null || true)"

  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git_branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null ||
      git rev-parse --short HEAD 2>/dev/null || true)"
  fi

  PROMPT="%F{$accent}⚡ xlfr4n%f %F{white}%n%f@%F{cyan}%m%f %F{$accent}%~%f"
  [ -n "$git_branch" ] && PROMPT+=" %F{yellow}[$git_branch]%f"
  PROMPT+="\n%F{$accent}╰─%f"
  [ -n "$target" ] && PROMPT+="%F{yellow}{TARGET:$target} %f"
  PROMPT+="%F{$accent}❯%f "

  RPROMPT="%F{242}%D{%H:%M:%S}%f"
}

add-zsh-hook precmd _kali_prompt

if [[ -o interactive && -z "${KALI_BSPWM_FASTFETCH_DONE:-}" && ( -z "${TMUX:-}" || "${XLFR4N_FASTFETCH:-0}" = 1 ) && -t 1 ]]; then
  # Keep the guard shell-local so every new interactive Ghostty session gets the Kali logo.
  typeset -g KALI_BSPWM_FASTFETCH_DONE=1
  command -v fastfetch >/dev/null 2>&1 && fastfetch
fi

# zsh-syntax-highlighting must be sourced last so it can wrap every widget defined above.
[[ -r /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] && source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
