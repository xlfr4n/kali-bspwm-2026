{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "Kali",
    "padding": {
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "red",
      "title": "light_red",
      "output": "white"
    },
    "key": {
      "width": 11,
      "type": "string"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "⚡ xLFr4n  //  {user-name}@{host-name}",
      "outputColor": "light_red"
    },
    {
      "type": "os",
      "key": "SYSTEM",
      "keyColor": "red",
      "format": "{name} {version}"
    },
    {
      "type": "kernel",
      "key": "KERNEL",
      "keyColor": "red"
    },
    {
      "type": "wm",
      "key": "DESKTOP",
      "keyColor": "red",
      "format": "{pretty-name}"
    },
    {
      "type": "terminal",
      "key": "TERMINAL",
      "keyColor": "red",
      "format": "{pretty-name}"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "keyColor": "red",
      "format": "{name} ({cores-logical}T)"
    },
    {
      "type": "memory",
      "key": "MEMORY",
      "keyColor": "red"
    },
    {
      "type": "disk",
      "key": "DISK",
      "keyColor": "red",
      "format": "{size-used} / {size-total}"
    },
    {
      "type": "display",
      "key": "DISPLAY",
      "keyColor": "red",
      "format": "{width}x{height}"
    },
    {
      "type": "shell",
      "key": "SHELL",
      "keyColor": "red",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "uptime",
      "key": "UPTIME",
      "keyColor": "red"
    },
    {
      "type": "packages",
      "key": "PACKAGES",
      "keyColor": "red"
    },
    {
      "type": "locale",
      "key": "LOCALE",
      "keyColor": "red"
    }
  ]
}
