{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/xLFr4n.logo",
    "padding": {
      "right": 5
    },
    "color": {
      "1": "blue",
      "2": "light_black"
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "red",
      "title": "light_red",
      "output": "white"
    },
    "key": {
      "width": 11,
      "type": "string"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "KALI // {user-name}@{host-name}",
      "outputColor": "light_red"
    },
    {
      "type": "os",
      "key": "SYSTEM",
      "keyColor": "red",
      "format": "{name} {version}"
    },
    {
      "type": "kernel",
      "key": "KERNEL",
      "keyColor": "red"
    },
    {
      "type": "wm",
      "key": "DESKTOP",
      "keyColor": "red",
      "format": "{pretty-name}"
    },
    {
      "type": "terminal",
      "key": "TERMINAL",
      "keyColor": "red",
      "format": "{pretty-name}"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "keyColor": "red",
      "format": "{name} ({cores-logical}T)"
    },
    {
      "type": "memory",
      "key": "MEMORY",
      "keyColor": "red"
    },
    {
      "type": "disk",
      "key": "DISK",
      "keyColor": "red",
      "format": "{size-used} / {size-total}"
    },
    {
      "type": "display",
      "key": "DISPLAY",
      "keyColor": "red",
      "format": "{width}x{height}"
    },
    {
      "type": "shell",
      "key": "SHELL",
      "keyColor": "red",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "uptime",
      "key": "UPTIME",
      "keyColor": "red"
    },
    {
      "type": "packages",
      "key": "PACKAGES",
      "keyColor": "red"
    },
    {
      "type": "locale",
      "key": "LOCALE",
      "keyColor": "red"
    },
    {
      "type": "command",
      "key": "TARGET",
      "keyColor": "red",
      "text": "target_file=\"$HOME/.config/polybar/target\"; target=$(cat \"$target_file\" 2>/dev/null || true); if [ -n \"$target\" ]; then printf \"%s\" \"$target\"; else printf \"not set\"; fi"
    },
    {
      "type": "localip",
      "key": "IP",
      "keyColor": "red",
      "showIpv4": true,
      "showIpv6": false,
      "showMac": false,
      "showLoop": false,
      "defaultRouteOnly": true
    },
    {
      "type": "datetime",
      "key": "DATE",
      "keyColor": "red",
      "format": "{day-pretty}/{month-pretty}/{year}  {hour-pretty}:{minute-pretty}"
    }
  ]
}
